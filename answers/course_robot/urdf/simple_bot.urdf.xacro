<?xml version="1.0"?>
<!-- Two-wheeled mobile robot: body (box) + 2 wheels + 1 front caster. Units: m, kg -->
<robot name="simple_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_camera" default="false"/>

  <!-- Values students can change -->
  <xacro:property name="body_x" value="0.40"/>
  <xacro:property name="body_y" value="0.30"/>
  <xacro:property name="body_z" value="0.10"/>
  <xacro:property name="wheel_r" value="0.06"/>
  <xacro:property name="wheel_w" value="0.04"/>
  <xacro:property name="wheel_gap" value="0.36"/>  <!-- distance between wheel centers -->

  <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="gray"><color rgba="0.6 0.6 0.6 1"/></material>

  <!-- base_footprint: reference point on the ground -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_r}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_z/2}"/>
      <geometry><box size="${body_x} ${body_y} ${body_z}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_z/2}"/>
      <geometry><box size="${body_x} ${body_y} ${body_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${body_z/2}"/>
      <mass value="2.0"/>
      <inertia ixx="${2.0*(body_y*body_y+body_z*body_z)/12}" ixy="0" ixz="0"
               iyy="${2.0*(body_x*body_x+body_z*body_z)/12}" iyz="0"
               izz="${2.0*(body_x*body_x+body_y*body_y)/12}"/>
    </inertial>
  </link>

  <!-- Wheel macro: side = 1 (left) or -1 (right) -->
  <xacro:macro name="wheel" params="name side">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <origin rpy="${pi/2} 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="${0.3*(3*wheel_r*wheel_r+wheel_w*wheel_w)/12}" ixy="0" ixz="0"
                 iyy="${0.3*(3*wheel_r*wheel_r+wheel_w*wheel_w)/12}" iyz="0"
                 izz="${0.3*wheel_r*wheel_r/2}"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="-0.08 ${side*wheel_gap/2} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left" side="1"/>
  <xacro:wheel name="right" side="-1"/>

  <!-- Caster: frictionless ball -->
  <link name="caster">
    <visual>
      <geometry><sphere radius="${wheel_r/2}"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry><sphere radius="${wheel_r/2}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="0.14 0 ${-wheel_r/2}"/>
  </joint>
  <gazebo reference="caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- Gazebo Harmonic plugins: wheel drive (cmd_vel -> wheels), position estimate (odom) -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_gap}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- Camera (optional): only with use_camera:=true. May be slow with CPU rendering -->
  <xacro:if value="$(arg use_camera)">
    <link name="camera_link">
      <visual>
        <geometry><box size="0.03 0.08 0.03"/></geometry>
        <material name="black"/>
      </visual>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_link"/>
      <origin xyz="${body_x/2} 0 ${body_z + 0.02}"/>
    </joint>
    <gazebo reference="camera_link">
      <sensor name="camera" type="camera">
        <update_rate>10</update_rate>
        <topic>camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image><width>320</width><height>240</height></image>
          <clip><near>0.05</near><far>20</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

</robot>
